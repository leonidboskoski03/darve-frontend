{
  "name": "@darve/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:connected": "node --use-system-ca tools/connected-product.mjs start",
    "product:check": "node --use-system-ca tools/connected-product.mjs check",
    "product:status": "node tools/connected-product.mjs status",
    "product:stop": "node tools/connected-product.mjs stop",
    "test:product:local": "node --use-system-ca tools/connected-product-acceptance.mjs",
    "build": "npm run typecheck && vite build && vite build --config vite.staff.config.ts",
    "dev:staff": "vite --config vite.staff.config.ts",
    "preview:staff": "vite preview --config vite.staff.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:architecture": "node --test tools/architecture.test.mjs",
    "test:ci": "node --test tools/ci-policy.test.mjs",
    "test:e2e": "npm run build:acceptance && playwright test",
    "build:acceptance": "vite build --config vite.acceptance.config.ts --mode acceptance",
    "preview:acceptance": "vite preview --config vite.acceptance.config.ts --mode acceptance",
    "docs:check": "node tools/check-docs.mjs",
    "check:docs": "npm run format:check && npm run docs:check",
    "check:dev": "npm run format:check && npm run lint && npm run docs:check && npm run contracts:check && npm run templates:check && npm run build",
    "check": "npm run check:dev && npm run test:architecture && npm run test:contracts && npm run test:ci && npm run test:operator && npm run test",
    "prepare": "node .husky/install.mjs",
    "contracts:pack": "node tools/contract-artifact.mjs pack",
    "contracts:check": "node tools/contract-artifact.mjs verify",
    "test:contracts": "node --test tools/contract-artifact.test.mjs",
    "api:local": "node tools/local-api.mjs",
    "test:api:local": "node tools/local-api-acceptance.mjs",
    "test:realtime:local": "node tools/local-realtime-acceptance.mjs",
    "test:creator:local": "node tools/local-creator-acceptance.mjs",
    "test:receiving:local": "node tools/local-receiving-acceptance.mjs",
    "test:payouts:local": "node tools/local-payout-settings-acceptance.mjs",
    "test:operator": "node --test tools/provider-login-config.test.mjs tools/local-collection.test.mjs tools/mobile-qr-relay.test.mjs tools/local-coins.test.mjs tools/connected-product.test.mjs",
    "provider:local": "node --use-system-ca tools/local-provider-login.mjs",
    "provider:audit": "node tools/provider-login-audit.mjs",
    "test:collection:local": "node tools/local-collection-acceptance.mjs",
    "test:review:local": "node tools/local-review-acceptance.mjs",
    "test:reporting:local": "node tools/local-reporting-acceptance.mjs",
    "test:contribution:local": "node tools/local-contribution-acceptance.mjs",
    "test:checkout:local": "node tools/local-checkout-acceptance.mjs",
    "test:obs:local": "node tools/local-obs-acceptance.mjs",
    "test:staff:local": "node tools/local-staff-acceptance.mjs ../tmp/backend-f06-checkout",
    "test:support:local": "node tools/local-support-acceptance.mjs ../tmp/backend-f06-checkout",
    "test:staff-support:local": "node tools/local-staff-support-acceptance.mjs ../tmp/backend-f06-checkout",
    "test:obs:phone": "node --use-system-ca tools/local-obs-acceptance.mjs ../tmp/backend-f06-readiness --observe --phone",
    "test:staff-admin:local": "node tools/local-staff-admin-acceptance.mjs ../tmp/backend-f06-checkout",
    "test:staff-recovery:local": "node tools/local-staff-recovery-acceptance.mjs ../tmp/backend-f06-checkout",
    "test:staff-combined:local": "node tools/local-staff-combined-acceptance.mjs ../tmp/backend-f06-checkout",
    "test:coins:local": "node tools/local-coin-acceptance.mjs ../tmp/backend-f06-checkout",
    "test:coins:journal": "node tools/local-coin-journal-acceptance.mjs ../tmp/backend-f06-checkout",
    "test:coins:creator": "node tools/local-creator-coins-acceptance.mjs ../tmp/backend-f06-checkout",
    "test:templates:local": "node tools/local-template-acceptance.mjs ../tmp/backend-f06-checkout",
    "templates:check": "node tools/template-assets.mjs && node --test tools/template-assets.test.mjs",
    "test:templates:obs": "node tools/local-template-obs-acceptance.mjs ../tmp/backend-f06-checkout",
    "test:staff-coins:local": "node tools/local-staff-coins-acceptance.mjs ../tmp/backend-f06-checkout",
    "test:coins:combined": "node tools/local-coins-combined-acceptance.mjs ../tmp/backend-f06-checkout",
    "test:lifecycle:local": "node tools/local-creator-lifecycle-acceptance.mjs ../tmp/backend-f06-checkout"
  },
  "dependencies": {
    "@darve/contracts": "file:vendor/contracts/darve-contracts-0ac317d952ca621f164f33c12c423659623f6019.tgz",
    "@gsap/react": "2.1.2",
    "@tanstack/react-query": "5.104.5",
    "framer-motion": "14.6.0",
    "gsap": "3.15.0",
    "lucide-react": "1.61.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "jsqr": "1.4.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
