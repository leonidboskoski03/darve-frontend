{
  "name": "@darve/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:architecture": "node --test tools/architecture.test.mjs",
    "test:ci": "node --test tools/ci-policy.test.mjs",
    "test:e2e": "playwright test",
    "docs:check": "node tools/check-docs.mjs",
    "check:docs": "npm run format:check && npm run docs:check",
    "check:dev": "npm run format:check && npm run lint && npm run docs:check && npm run contracts:check && npm run build",
    "check": "npm run check:dev && npm run test:architecture && npm run test:contracts && npm run test:ci && npm run test",
    "prepare": "node .husky/install.mjs",
    "contracts:pack": "node tools/contract-artifact.mjs pack",
    "contracts:check": "node tools/contract-artifact.mjs verify",
    "test:contracts": "node --test tools/contract-artifact.test.mjs",
    "api:local": "node tools/local-api.mjs",
    "test:api:local": "node tools/local-api-acceptance.mjs",
    "test:realtime:local": "node tools/local-realtime-acceptance.mjs"
  },
  "dependencies": {
    "@darve/contracts": "file:vendor/contracts/darve-contracts-e12b84de3959f6fdbd7eba04ffdfa135f6ba47aa.tgz",
    "@gsap/react": "2.1.2",
    "@tanstack/react-query": "5.104.5",
    "framer-motion": "14.6.0",
    "gsap": "3.15.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
